# Optional configuration file: copy to ".env" and fill in only the values you need.

# Spotify Client ID override (optional; uses built-in client ID by default)
SPOTIFY_CLIENT_ID=

# YouTube Music Brand Account ID (optional; passed as user= to YTMusic)
YT_BRAND_ACCOUNT_ID=

# YouTube Music Cookie auto-setup (optional; rebuilds oauth.json automatically)
YTMUSIC_COOKIE=
YTMUSIC_AUTHUSER=0
